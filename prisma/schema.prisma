generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SessionState {
  ACTIVE
  INACTIVE
  RECONNECTING
  ENDED
}

enum EventKind {
  JOIN
  HEARTBEAT
  LEAVE
  SHUTDOWN
}

model Identity {
  id            String    @id @default(cuid())
  robloxUserId  BigInt    @unique
  robloxUsername String
  discordUserId String?
  mappingCheckedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]

  @@index([discordUserId])
}

model Session {
  id                    String       @id @default(cuid())
  identityId            String
  identity              Identity     @relation(fields: [identityId], references: [id])
  state                 SessionState
  startedAt             DateTime
  endedAt               DateTime?
  lastEventAt           DateTime
  lastStateAt           DateTime
  reconnectDeadline     DateTime?
  activeMilliseconds    BigInt       @default(0)
  inactiveMilliseconds  BigInt       @default(0)
  reconnectMilliseconds BigInt       @default(0)
  rankNumber            Int
  rankName              String
  universeId            BigInt
  placeId               BigInt
  jobId                 String
  deletedAt             DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  segments              TimeSegment[]
  discordMessage        DiscordMessage?
  announcement          SessionAnnouncement?
  auditEntries          AuditEntry[]

  @@index([identityId, startedAt])
  @@index([state, reconnectDeadline])
  @@index([deletedAt, startedAt])
}

model TimeSegment {
  id        String       @id @default(cuid())
  sessionId String
  session   Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  state     SessionState
  startedAt DateTime
  endedAt   DateTime?

  @@index([sessionId, startedAt])
}

model DiscordMessage {
  id        String   @id @default(cuid())
  sessionId String   @unique
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  channelId String
  messageId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One announcement message per session in the staff chat channel, kept apart
/// from the session-log message so the two channels are independent.
model SessionAnnouncement {
  id        String   @id @default(cuid())
  sessionId String   @unique
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  channelId String
  messageId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RuntimeSettings {
  id              String   @id
  logsChannelId   String?
  /// Staff chat channel the bot announces shifts in. Empty disables announcements.
  staffChannelId  String?
  trackingEnabled Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PermissionRole {
  roleId    String   @id
  level     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProcessedEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  kind        EventKind
  occurredAt  DateTime
  receivedAt  DateTime  @default(now())
  sessionId   String?

  @@index([receivedAt])
}

enum TaigaCardKind {
  BUG
  SUGGESTION
}

/// A Discord forum post paired with the Taiga user story it created. Only posts
/// created after the integration was switched on ever get a row here.
model TaigaCard {
  id              String        @id @default(cuid())
  taigaStoryId    Int           @unique
  taigaRef        Int
  guildId         String
  channelId       String
  threadId        String        @unique
  kind            TaigaCardKind
  title           String
  statusName      String
  authorDiscordId String
  authorName      String
  declinedAt      DateTime?
  /// Set just before the bot deletes the story in Taiga, so the webhook the
  /// deletion triggers is not mistaken for someone declining the card.
  deleting        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([statusName])
}

/// Idempotency keys for Taiga webhook deliveries, which Taiga may retry.
model TaigaWebhookDelivery {
  id          String   @id @default(cuid())
  fingerprint String   @unique
  receivedAt  DateTime @default(now())

  @@index([receivedAt])
}

/// Last known state of each epic, so the webhook and the reconcile sweep cannot
/// both announce the same change.
model TaigaEpicState {
  taigaEpicId Int      @id
  ref         Int
  subject     String
  statusName  String?
  isClosed    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TaigaSettings {
  id                       String    @id
  enabled                  Boolean   @default(false)
  bugForumChannelId        String?
  suggestionForumChannelId String?
  notificationChannelId    String?
  /// Posts created before this instant are never touched.
  activatedAt              DateTime?
  /// Set once the existing epics have been recorded without announcing them.
  epicsSeededAt            DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

/// Persisted eligibility dates for Discord members who currently have the
/// Unverified role. Discord does not expose when a role was assigned, so the
/// first observation is the start of the one-month verification period.
model VerificationMember {
  guildId       String
  discordUserId String
  firstSeenAt   DateTime @default(now())
  warnedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@id([guildId, discordUserId])
  @@index([guildId, firstSeenAt])
  @@index([guildId, warnedAt])
}

/// Keeps the three-day reminder cadence stable across bot restarts.
model VerificationSchedule {
  guildId        String   @id
  lastReminderAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AuditEntry {
  id          String   @id @default(cuid())
  sessionId   String?
  session     Session? @relation(fields: [sessionId], references: [id])
  actorType   String
  actorId     String
  action      String
  note        String?
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  @@index([sessionId, createdAt])
}

enum CommandServerType {
  PUBLIC
  STUDIO
}

enum CommandRisk {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Where Adonis command runs are posted. The channel is chosen in `/config`,
/// never from the environment.
model CommandLogSettings {
  id             String   @id
  enabled        Boolean  @default(false)
  channelId      String?
  /// Studio playtests are logged too while this is on, so the plugin can be
  /// tested without publishing a place.
  includeStudio  Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// One Discord thread per Roblox server, so the channel stays readable. The
/// job id is the identity of a running server, which is exactly what a thread
/// should be named after.
model CommandLogThread {
  jobId        String   @id
  channelId    String
  threadId     String   @unique
  /// The channel message the thread hangs off. It is the server's live panel:
  /// who is in it, and the controls for acting on them.
  panelMessageId String?
  placeId      BigInt
  serverType   CommandServerType @default(PUBLIC)
  playerCount  Int      @default(0)
  maxPlayers   Int      @default(0)
  /// The staff currently in the server, as last reported by the plugin. This
  /// is a projection of a running server, not a record, so it is stored whole
  /// and replaced whole rather than modelled as rows.
  staff        Json     @default("[]")
  /// When the plugin last reported. A server that stops reporting is closed by
  /// the sweep, because a crashed server never says goodbye.
  lastSeenAt   DateTime @default(now())
  closedAt     DateTime?
  createdAt    DateTime @default(now())
  lastPostedAt DateTime @default(now())

  @@index([lastPostedAt])
  @@index([closedAt, lastSeenAt])
}

/// One Adonis command run. `eventId` is the plugin's idempotency key, so a
/// retried batch cannot post the same command twice.
model CommandLogEntry {
  id             String      @id @default(cuid())
  eventId        String      @unique
  jobId          String
  placeId        BigInt
  robloxUserId   BigInt
  robloxUsername String
  rankNumber     Int
  rankName       String
  /// The Adonis level the person holds, and the level the command demands.
  adminLevel     Int
  requiredLevel  Int
  commandText    String
  /// The Adonis index (`Kick`) and the alias that was typed (`kick`). Both are
  /// kept because only the pair identifies a command unambiguously.
  commandName    String
  commandAlias   String
  serverType     CommandServerType
  playerCount    Int
  maxPlayers     Int
  risk           CommandRisk
  targets        String[]
  threadId       String?
  messageId      String?
  occurredAt     DateTime
  createdAt      DateTime    @default(now())

  @@index([robloxUserId, occurredAt])
  @@index([createdAt])
}

/// A staff member's command access, taken away for fifteen minutes from
/// Discord. The Roblox plugin polls these, so a block needs no Open Cloud key
/// and works in Studio.
model CommandBlock {
  robloxUserId    BigInt   @id
  robloxUsername  String
  expiresAt       DateTime
  byDiscordUserId String
  byDiscordName   String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
}
